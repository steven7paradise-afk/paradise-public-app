{% assign p2=block.settings.enable_payment_2 %}
<section class="paradise-kylie-booking pkb-no-visual{% unless p2 %} pkb-single-payment{% endunless %}" data-paradise-booking style="--pkb-bg:{{ block.settings.background_color }};--pkb-ink:{{ block.settings.text_color }};--pkb-pink:{{ block.settings.accent_color }};--pkb-border:{{ block.settings.border_color }};" {{ block.shopify_attributes }}>
<div class="paradise-kylie-booking__shell">
<div class="paradise-kylie-booking__content">
<div class="paradise-kylie-booking__top">{% if block.settings.eyebrow != blank %}<span>{{ block.settings.eyebrow }}</span>{% endif %}{% if block.settings.title != blank %}<h2>{{ block.settings.title }}</h2>{% endif %}{% if block.settings.subtitle != blank %}<p>{{ block.settings.subtitle }}</p>{% endif %}</div>
<div class="paradise-kylie-booking__progress"><button type="button" class="is-active" data-step-trigger="1"><span>01</span>Salone</button><button type="button" data-step-trigger="2"><span>02</span>Pagamento</button><button type="button" data-step-trigger="3"><span>03</span>Orario</button></div>
<section class="paradise-kylie-booking__step" data-step="1"><div class="paradise-kylie-booking__step-head"><small>Step 01</small><h3>Scegli il salone</h3></div><div class="paradise-kylie-booking__choice-grid">
<button type="button" class="paradise-kylie-booking__choice is-active" data-salon="duomo"><span class="paradise-kylie-booking__choice-media">{% if block.settings.salon_1_image != blank %}{{ block.settings.salon_1_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.salon_1_label }}{% endif %}</span><strong>{{ block.settings.salon_1_label }}</strong>{% if block.settings.salon_1_description != blank %}<em>{{ block.settings.salon_1_description }}</em>{% endif %}</button>
<button type="button" class="paradise-kylie-booking__choice" data-salon="buenos"><span class="paradise-kylie-booking__choice-media">{% if block.settings.salon_2_image != blank %}{{ block.settings.salon_2_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.salon_2_label }}{% endif %}</span><strong>{{ block.settings.salon_2_label }}</strong>{% if block.settings.salon_2_description != blank %}<em>{{ block.settings.salon_2_description }}</em>{% endif %}</button>
</div><div class="pkb-actions pkb-single"><button type="button" class="paradise-kylie-booking__primary" data-next-step>Continua</button></div></section>
<section class="paradise-kylie-booking__step" data-step="2" hidden><div class="paradise-kylie-booking__step-head"><small>Step 02</small><h3>{{ block.settings.step_2_title }}</h3></div><div class="paradise-kylie-booking__choice-grid paradise-kylie-booking__payment-grid"><button type="button" class="paradise-kylie-booking__choice is-active" data-payment="acconto"><strong>{{ block.settings.payment_1_label }}</strong>{% if block.settings.payment_1_description != blank %}<em>{{ block.settings.payment_1_description }}</em>{% endif %}</button>{% if p2 %}<button type="button" class="paradise-kylie-booking__choice" data-payment="rate"><strong>{{ block.settings.payment_2_label }}</strong>{% if block.settings.payment_2_description != blank %}<em>{{ block.settings.payment_2_description }}</em>{% endif %}</button>{% endif %}</div><div class="pkb-actions"><button type="button" class="paradise-kylie-booking__ghost" data-prev-step>Indietro</button><button type="button" class="paradise-kylie-booking__primary" data-next-step>Continua</button></div></section>
<section class="paradise-kylie-booking__step" data-step="3" hidden><div class="paradise-kylie-booking__step-head"><small>Step 03</small><h3>Scegli l'orario</h3></div><div class="paradise-kylie-booking__summary"><div><small>Salone</small><strong data-summary-salon>{{ block.settings.salon_1_label }}</strong></div><div><small>Pagamento</small><strong data-summary-payment>{{ block.settings.payment_1_label }}</strong></div></div><div class="paradise-kylie-booking__calendar"><div class="paradise-kylie-booking__calendar-panel is-active" data-calendar="duomo-acconto">{{ block.settings.salon_1_payment_1_code }}</div>{% if p2 %}<div class="paradise-kylie-booking__calendar-panel" data-calendar="duomo-rate" hidden>{{ block.settings.salon_1_payment_2_code }}</div>{% endif %}<div class="paradise-kylie-booking__calendar-panel" data-calendar="buenos-acconto" hidden>{{ block.settings.salon_2_payment_1_code }}</div>{% if p2 %}<div class="paradise-kylie-booking__calendar-panel" data-calendar="buenos-rate" hidden>{{ block.settings.salon_2_payment_2_code }}</div>{% endif %}</div><div class="pkb-actions pkb-single"><button type="button" class="paradise-kylie-booking__ghost" data-prev-step>Indietro</button></div></section>
</div>
</div></section>
{% schema %}
{"name":"Paradise Booking","target":"section","stylesheet":"paradise-booking-steps.css","javascript":"paradise-booking-steps.js","settings":[{"type":"text","id":"eyebrow","label":"Etichetta","default":"Prenotazione"},{"type":"text","id":"title","label":"Titolo","default":"Applica le Extension Paradise"},{"type":"textarea","id":"subtitle","label":"Descrizione","default":"Seleziona salone, pagamento e orario disponibile."},{"type":"color","id":"background_color","label":"Sfondo","default":"#fff6fa"},{"type":"color","id":"text_color","label":"Testo","default":"#151013"},{"type":"color","id":"accent_color","label":"Rosa","default":"#e7689f"},{"type":"color","id":"border_color","label":"Bordo","default":"#f4c9dc"},{"type":"text","id":"salon_1_label","label":"Salone 1","default":"Duomo"},{"type":"textarea","id":"salon_1_description","label":"Desc. salone 1","default":"Via Paolo da Cannobio, 8"},{"type":"image_picker","id":"salon_1_image","label":"Img salone 1"},{"type":"textarea","id":"salon_1_payment_1_code","label":"S1 P1","default":"<div class=\"cowlendar-section services-list-72\"></div>"},{"type":"textarea","id":"salon_1_payment_2_code","label":"S1 P2","default":"<div class=\"cowlendar-section services-list-73\"></div>"},{"type":"text","id":"salon_2_label","label":"Salone 2","default":"Buenos Aires"},{"type":"textarea","id":"salon_2_description","label":"Desc. salone 2","default":"Corso Buenos Aires, 77"},{"type":"image_picker","id":"salon_2_image","label":"Img salone 2"},{"type":"textarea","id":"salon_2_payment_1_code","label":"S2 P1","default":"<div class=\"cowlendar-section services-list-74\"></div>"},{"type":"textarea","id":"salon_2_payment_2_code","label":"S2 P2","default":"<div class=\"cowlendar-section services-list-75\"></div>"},{"type":"text","id":"step_2_title","label":"Titolo step 2","default":"Scegli pagamento"},{"type":"text","id":"payment_1_label","label":"Pagamento 1","default":"Acconto 50€"},{"type":"textarea","id":"payment_1_description","label":"Desc. pagamento 1","default":"Blocca l'appuntamento e salda in salone."},{"type":"checkbox","id":"enable_payment_2","label":"Abilita rate","default":true},{"type":"text","id":"payment_2_label","label":"Pagamento 2","default":"A rate"},{"type":"textarea","id":"payment_2_description","label":"Desc. pagamento 2","default":"Paga la prima rata online."}]}
{% endschema %}
