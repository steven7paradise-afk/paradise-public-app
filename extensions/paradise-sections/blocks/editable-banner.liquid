{% assign slider_id = 'paradise-maison-slider-' | append: block.id %}
{% assign slide_count = 0 %}
{% if block.settings.slide_1_enabled %}
  {% assign slide_count = slide_count | plus: 1 %}
{% endif %}
{% if block.settings.slide_2_enabled %}
  {% assign slide_count = slide_count | plus: 1 %}
{% endif %}
{% if block.settings.slide_3_enabled %}
  {% assign slide_count = slide_count | plus: 1 %}
{% endif %}

{% if block.settings.enabled %}
  {% if slide_count > 0 %}
  <section
  id="{{ slider_id }}"
  class="paradise-maison-slider{% if block.settings.desktop_ratio == 'original_image' %} pms-fit--original-desktop{% endif %}"
  aria-label="{{ block.settings.accessibility_label | escape }}"
  style="
    --pms-panel-bg: {{ block.settings.panel_background }};
    --pms-panel-opacity: {{ block.settings.panel_opacity | divided_by: 100.0 }};
    --pms-black: {{ block.settings.panel_text_color }};
    --pms-white: {{ block.settings.button_text_color }};
    --pms-button-bg: {{ block.settings.button_background }};
    --pms-button-border: {{ block.settings.button_border_color }};
    --pms-button-hover-bg: {{ block.settings.button_hover_background }};
    --pms-button-hover-text: {{ block.settings.button_hover_text_color }};
    --pms-arrow-bg-rgb: {{ block.settings.arrow_background.red }}, {{ block.settings.arrow_background.green }}, {{ block.settings.arrow_background.blue }};
    --pms-arrow-text: {{ block.settings.arrow_text_color }};
    --pms-arrow-border-rgb: {{ block.settings.arrow_border_color.red }}, {{ block.settings.arrow_border_color.green }}, {{ block.settings.arrow_border_color.blue }};
    --pms-arrow-hover-bg: {{ block.settings.arrow_hover_background }};
    --pms-arrow-hover-text: {{ block.settings.arrow_hover_text_color }};
    --pms-arrow-opacity: {{ block.settings.arrow_opacity | divided_by: 100.0 }};
    --pms-arrow-border-opacity: {{ block.settings.arrow_border_opacity | divided_by: 100.0 }};
    --pms-card-line: {{ block.settings.panel_border_color }};
    --pms-frame: {{ block.settings.frame_color }};
    --pms-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    --pms-button-radius: {{ block.settings.button_radius }}px;
    --pms-panel-radius: {{ block.settings.panel_radius }}px;
    --pms-arrow-radius: {{ block.settings.arrow_radius }}px;
    --pms-desktop-height: {{ block.settings.desktop_height }}px;
    --pms-desktop-position: {{ block.settings.desktop_image_position }};
    --pms-mobile-position: {{ block.settings.mobile_image_position }};
    --pms-mobile-min-height: {{ block.settings.mobile_min_height }}px;
  "
  data-pms-autoplay="{{ block.settings.autoplay }}"
  data-pms-delay="{{ block.settings.autoplay_delay | times: 1000 }}"
  {{ block.shopify_attributes }}
>
  <div class="pms-shell">
    <div class="pms-slider" data-pms-slider>
      <div class="pms-viewport" data-pms-viewport>
        <div class="pms-track" data-pms-track>
          {% assign rendered_slide_index = 0 %}
          {% if block.settings.slide_1_enabled %}
            {% assign slide_image = block.settings.slide_1_image %}
            {% assign slide_mobile_image = block.settings.slide_1_mobile_image | default: slide_image %}
            {% assign slide_alt = slide_image.alt | default: block.settings.slide_1_title %}
            <article class="pms-slide" data-pms-slide aria-hidden="{% if rendered_slide_index == 0 %}false{% else %}true{% endif %}">
              <picture class="pms-picture">
                {% if slide_mobile_image != blank %}
                  <source media="(max-width: 749px)" srcset="{{ slide_mobile_image | image_url: width: 1200 }}">
                {% endif %}
                {% if slide_image != blank %}
                  {{ slide_image | image_url: width: 3200 | image_tag: loading: 'eager', widths: '750, 1100, 1500, 2000, 2400, 3200', sizes: '100vw', alt: slide_alt }}
                {% else %}
                  {{ 'lifestyle-1' | placeholder_svg_tag }}
                {% endif %}
              </picture>
              <div class="pms-overlay"></div>
              {% if block.settings.show_frame %}<div class="pms-frame" aria-hidden="true"></div>{% endif %}
              <div class="pms-content pms-content--{{ block.settings.slide_1_position }}">
                <div class="pms-panel">
                  {% if block.settings.slide_1_kicker != blank %}<p class="pms-kicker">{{ block.settings.slide_1_kicker }}</p>{% endif %}
                  {% if block.settings.slide_1_title != blank %}<h2 class="pms-title">{{ block.settings.slide_1_title }}</h2>{% endif %}
                  {% if block.settings.slide_1_text != blank %}<div class="pms-text">{{ block.settings.slide_1_text }}</div>{% endif %}
                  {% if block.settings.slide_1_button_label != blank and block.settings.slide_1_button_link != blank %}
                    <a class="pms-button" href="{{ block.settings.slide_1_button_link }}">{{ block.settings.slide_1_button_label }}</a>
                  {% endif %}
                </div>
              </div>
            </article>
            {% assign rendered_slide_index = rendered_slide_index | plus: 1 %}
          {% endif %}

          {% if block.settings.slide_2_enabled %}
            {% assign slide_image = block.settings.slide_2_image %}
            {% assign slide_mobile_image = block.settings.slide_2_mobile_image | default: slide_image %}
            {% assign slide_alt = slide_image.alt | default: block.settings.slide_2_title %}
            <article class="pms-slide" data-pms-slide aria-hidden="{% if rendered_slide_index == 0 %}false{% else %}true{% endif %}">
              <picture class="pms-picture">
                {% if slide_mobile_image != blank %}
                  <source media="(max-width: 749px)" srcset="{{ slide_mobile_image | image_url: width: 1200 }}">
                {% endif %}
                {% if slide_image != blank %}
                  {{ slide_image | image_url: width: 3200 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000, 2400, 3200', sizes: '100vw', alt: slide_alt }}
                {% else %}
                  {{ 'lifestyle-2' | placeholder_svg_tag }}
                {% endif %}
              </picture>
              <div class="pms-overlay"></div>
              {% if block.settings.show_frame %}<div class="pms-frame" aria-hidden="true"></div>{% endif %}
              <div class="pms-content pms-content--{{ block.settings.slide_2_position }}">
                <div class="pms-panel">
                  {% if block.settings.slide_2_kicker != blank %}<p class="pms-kicker">{{ block.settings.slide_2_kicker }}</p>{% endif %}
                  {% if block.settings.slide_2_title != blank %}<h2 class="pms-title">{{ block.settings.slide_2_title }}</h2>{% endif %}
                  {% if block.settings.slide_2_text != blank %}<div class="pms-text">{{ block.settings.slide_2_text }}</div>{% endif %}
                  {% if block.settings.slide_2_button_label != blank and block.settings.slide_2_button_link != blank %}
                    <a class="pms-button" href="{{ block.settings.slide_2_button_link }}">{{ block.settings.slide_2_button_label }}</a>
                  {% endif %}
                </div>
              </div>
            </article>
            {% assign rendered_slide_index = rendered_slide_index | plus: 1 %}
          {% endif %}

          {% if block.settings.slide_3_enabled %}
            {% assign slide_image = block.settings.slide_3_image %}
            {% assign slide_mobile_image = block.settings.slide_3_mobile_image | default: slide_image %}
            {% assign slide_alt = slide_image.alt | default: block.settings.slide_3_title %}
            <article class="pms-slide" data-pms-slide aria-hidden="{% if rendered_slide_index == 0 %}false{% else %}true{% endif %}">
              <picture class="pms-picture">
                {% if slide_mobile_image != blank %}
                  <source media="(max-width: 749px)" srcset="{{ slide_mobile_image | image_url: width: 1200 }}">
                {% endif %}
                {% if slide_image != blank %}
                  {{ slide_image | image_url: width: 3200 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000, 2400, 3200', sizes: '100vw', alt: slide_alt }}
                {% else %}
                  {{ 'lifestyle-1' | placeholder_svg_tag }}
                {% endif %}
              </picture>
              <div class="pms-overlay"></div>
              {% if block.settings.show_frame %}<div class="pms-frame" aria-hidden="true"></div>{% endif %}
              <div class="pms-content pms-content--{{ block.settings.slide_3_position }}">
                <div class="pms-panel">
                  {% if block.settings.slide_3_kicker != blank %}<p class="pms-kicker">{{ block.settings.slide_3_kicker }}</p>{% endif %}
                  {% if block.settings.slide_3_title != blank %}<h2 class="pms-title">{{ block.settings.slide_3_title }}</h2>{% endif %}
                  {% if block.settings.slide_3_text != blank %}<div class="pms-text">{{ block.settings.slide_3_text }}</div>{% endif %}
                  {% if block.settings.slide_3_button_label != blank and block.settings.slide_3_button_link != blank %}
                    <a class="pms-button" href="{{ block.settings.slide_3_button_link }}">{{ block.settings.slide_3_button_label }}</a>
                  {% endif %}
                </div>
              </div>
            </article>
            {% assign rendered_slide_index = rendered_slide_index | plus: 1 %}
          {% endif %}
        </div>
      </div>

      {% if slide_count > 1 and block.settings.show_arrows %}
        <button class="pms-arrow pms-arrow--prev" type="button" aria-label="Slide precedente" data-pms-prev>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        <button class="pms-arrow pms-arrow--next" type="button" aria-label="Slide successiva" data-pms-next>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      {% endif %}

      {% if slide_count > 1 and block.settings.show_dots %}
        <div class="pms-dots" aria-label="Navigazione slider">
          {% for index in (1..slide_count) %}
            {% assign dot_index = index | minus: 1 %}
            <button
              class="pms-dot{% if forloop.first %} is-active{% endif %}"
              type="button"
              aria-label="Vai alla slide {{ index }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              data-pms-dot="{{ dot_index }}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
  </section>
  {% elsif request.design_mode %}
    <div class="paradise-maison-slider-placeholder" {{ block.shopify_attributes }}>
      <strong>Nessuna slide attiva</strong>
      <span>Attiva almeno una slide nelle impostazioni per mostrare lo slider.</span>
    </div>
  {% endif %}
{% elsif request.design_mode %}
  <div class="paradise-maison-slider-placeholder" {{ block.shopify_attributes }}>
    <strong>Slider Maison disattivato</strong>
    <span>Apri le impostazioni e attiva "Mostra slider" per renderlo visibile nel sito.</span>
  </div>
{% endif %}

{% schema %}
{
  "name": "Slider Maison",
  "target": "section",
  "stylesheet": "maison-slider.css",
  "javascript": "maison-slider.js",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Mostra slider",
      "default": false
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Etichetta accessibilita'",
      "default": "Banner Paradise luxury"
    },
    {
      "type": "header",
      "content": "Controlli slider"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Attiva scorrimento automatico",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Tempo tra le slide",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostra frecce",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Mostra indicatori",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_frame",
      "label": "Mostra cornice immagine",
      "default": true
    },
    {
      "type": "select",
      "id": "desktop_ratio",
      "label": "Formato immagine desktop",
      "default": "fixed_height",
      "options": [
        { "value": "original_image", "label": "Originale immagine" },
        { "value": "fixed_height", "label": "Altezza personalizzata" },
        { "value": "16 / 5.6", "label": "Largo vecchio" },
        { "value": "16 / 6.45", "label": "Maison vecchio" },
        { "value": "16 / 7.5", "label": "Sottile vecchio" },
        { "value": "16 / 9", "label": "Classico vecchio" }
      ]
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 320,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Altezza desktop",
      "default": 820
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Posizione immagine desktop",
      "default": "center center",
      "options": [
        { "value": "center center", "label": "Centro" },
        { "value": "center top", "label": "Alto" },
        { "value": "center bottom", "label": "Basso" },
        { "value": "left center", "label": "Sinistra" },
        { "value": "right center", "label": "Destra" }
      ]
    },
    {
      "type": "range",
      "id": "mobile_min_height",
      "min": 360,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Altezza mobile",
      "default": 720
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Posizione immagine mobile",
      "default": "center center",
      "options": [
        { "value": "center center", "label": "Centro" },
        { "value": "center top", "label": "Alto" },
        { "value": "center bottom", "label": "Basso" },
        { "value": "left center", "label": "Sinistra" },
        { "value": "right center", "label": "Destra" }
      ]
    },
    {
      "type": "header",
      "content": "Stile"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Sfondo pannello",
      "default": "#faf7f2"
    },
    {
      "type": "range",
      "id": "panel_opacity",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacita' pannello",
      "default": 90
    },
    {
      "type": "color",
      "id": "panel_text_color",
      "label": "Colore testo pannello",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "panel_border_color",
      "label": "Colore bordo pannello",
      "default": "#ded8cf"
    },
    {
      "type": "range",
      "id": "panel_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Rotondita' pannello",
      "default": 0
    },
    {
      "type": "color",
      "id": "frame_color",
      "label": "Colore cornice",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Opacita' overlay immagine",
      "default": 15
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Sfondo bottone",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Colore testo bottone",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Colore bordo bottone",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Sfondo bottone al passaggio",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Testo bottone al passaggio",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Rotondita' bottone",
      "default": 0
    },
    {
      "type": "range",
      "id": "arrow_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Rotondita' frecce",
      "default": 0
    },
    {
      "type": "color",
      "id": "arrow_background",
      "label": "Sfondo frecce",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "arrow_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Trasparenza sfondo frecce",
      "default": 40
    },
    {
      "type": "color",
      "id": "arrow_text_color",
      "label": "Colore icona frecce",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "arrow_border_color",
      "label": "Colore bordo frecce",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "arrow_border_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Trasparenza bordo frecce",
      "default": 70
    },
    {
      "type": "color",
      "id": "arrow_hover_background",
      "label": "Sfondo frecce al passaggio",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "arrow_hover_text_color",
      "label": "Icona frecce al passaggio",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Slide 1"
    },
    {
      "type": "checkbox",
      "id": "slide_1_enabled",
      "label": "Attiva slide 1",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "slide_1_image",
      "label": "Immagine desktop"
    },
    {
      "type": "image_picker",
      "id": "slide_1_mobile_image",
      "label": "Immagine mobile"
    },
    {
      "type": "text",
      "id": "slide_1_kicker",
      "label": "Etichetta piccola",
      "default": "Paradise Collection"
    },
    {
      "type": "text",
      "id": "slide_1_title",
      "label": "Titolo",
      "default": "Clip-In Paradise"
    },
    {
      "type": "richtext",
      "id": "slide_1_text",
      "label": "Testo",
      "default": "<p>Extension in capelli veri per aggiungere volume e lunghezza con un risultato naturale, elegante e immediato.</p>"
    },
    {
      "type": "text",
      "id": "slide_1_button_label",
      "label": "Testo bottone",
      "default": "Scopri la collezione"
    },
    {
      "type": "url",
      "id": "slide_1_button_link",
      "label": "Link bottone"
    },
    {
      "type": "select",
      "id": "slide_1_position",
      "label": "Posizione pannello",
      "default": "left",
      "options": [
        { "value": "left", "label": "Sinistra" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Destra" }
      ]
    },
    {
      "type": "header",
      "content": "Slide 2"
    },
    {
      "type": "checkbox",
      "id": "slide_2_enabled",
      "label": "Attiva slide 2",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "slide_2_image",
      "label": "Immagine desktop"
    },
    {
      "type": "image_picker",
      "id": "slide_2_mobile_image",
      "label": "Immagine mobile"
    },
    {
      "type": "text",
      "id": "slide_2_kicker",
      "label": "Etichetta piccola",
      "default": "Paradise Academy"
    },
    {
      "type": "text",
      "id": "slide_2_title",
      "label": "Titolo",
      "default": "Corso Extension"
    },
    {
      "type": "richtext",
      "id": "slide_2_text",
      "label": "Testo",
      "default": "<p>Una formazione professionale pensata per apprendere il metodo Paradise in modo pratico, completo e professionale.</p>"
    },
    {
      "type": "text",
      "id": "slide_2_button_label",
      "label": "Testo bottone",
      "default": "Scopri il corso"
    },
    {
      "type": "url",
      "id": "slide_2_button_link",
      "label": "Link bottone"
    },
    {
      "type": "select",
      "id": "slide_2_position",
      "label": "Posizione pannello",
      "default": "left",
      "options": [
        { "value": "left", "label": "Sinistra" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Destra" }
      ]
    },
    {
      "type": "header",
      "content": "Slide 3"
    },
    {
      "type": "checkbox",
      "id": "slide_3_enabled",
      "label": "Attiva slide 3",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "slide_3_image",
      "label": "Immagine desktop"
    },
    {
      "type": "image_picker",
      "id": "slide_3_mobile_image",
      "label": "Immagine mobile"
    },
    {
      "type": "text",
      "id": "slide_3_kicker",
      "label": "Etichetta piccola",
      "default": "Paradise Beauty"
    },
    {
      "type": "text",
      "id": "slide_3_title",
      "label": "Titolo",
      "default": "Nuovo banner"
    },
    {
      "type": "richtext",
      "id": "slide_3_text",
      "label": "Testo",
      "default": "<p>Carica una nuova immagine e personalizza questo contenuto dal theme editor Shopify.</p>"
    },
    {
      "type": "text",
      "id": "slide_3_button_label",
      "label": "Testo bottone",
      "default": "Scopri di piu'"
    },
    {
      "type": "url",
      "id": "slide_3_button_link",
      "label": "Link bottone"
    },
    {
      "type": "select",
      "id": "slide_3_position",
      "label": "Posizione pannello",
      "default": "left",
      "options": [
        { "value": "left", "label": "Sinistra" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Destra" }
      ]
    }
  ]
}
{% endschema %}
