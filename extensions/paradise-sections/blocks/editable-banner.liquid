{% assign section_id = 'slider-maison-' | append: block.id %}
{% assign mobile_benefits_display = 'flex' %}
{% if block.settings.show_benefits_mobile == false %}
{% assign mobile_benefits_display = 'none' %}
{% endif %}
{% if block.settings.enabled %}
<section
id="{{ section_id }}"
class="slider-maison slider-maison--{{ block.settings.layout }} slider-maison--model-{{ block.settings.model_side }} slider-maison--mobile-model-{{ block.settings.mobile_model_position }} slider-maison--mobile-copy-{{ block.settings.mobile_copy_flow }} slider-maison--mobile-buttons-{{ block.settings.mobile_button_layout }}"
style="
--sm-bg: {{ block.settings.background_color }};
--sm-text: {{ block.settings.text_color }};
--sm-accent: {{ block.settings.accent_color }};
--sm-overlay-color: {{ block.settings.overlay_color }};
--sm-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
--sm-scroll-strength: 20;
--sm-height: {{ block.settings.desktop_height }}px;
--sm-mobile-height: {{ block.settings.mobile_height }}px;
--sm-radius: 0px;
--sm-title: {{ block.settings.title_size }}px;
--sm-mobile-title: {{ block.settings.mobile_title_size }}px;
--sm-mobile-title-width: 100%;
--sm-title-line: {{ block.settings.title_line_height | divided_by: 100.0 }};
--sm-text-gap: {{ block.settings.text_gap }}px;
--sm-mobile-text-gap: {{ block.settings.mobile_text_gap }}px;
--sm-model-mobile-gap: 20px;
--sm-content-width: {{ block.settings.content_width }}px;
--sm-layout-scale: {{ block.settings.layout_scale | divided_by: 100.0 }};
--sm-text-x: {{ block.settings.text_x }}%;
--sm-text-y: {{ block.settings.text_y }}%;
--sm-mobile-text-x: {{ block.settings.mobile_text_x }}%;
--sm-mobile-text-y: {{ block.settings.mobile_text_y }}%;
--sm-bottom-x: {{ block.settings.bottom_text_x }}%;
--sm-bottom-y: {{ block.settings.bottom_text_y }}%;
--sm-mobile-bottom-x: {{ block.settings.mobile_bottom_text_x }}%;
--sm-mobile-bottom-y: {{ block.settings.mobile_bottom_text_y }}%;
--sm-kicker-weight: {{ block.settings.kicker_weight }};
--sm-title-weight: {{ block.settings.title_weight }};
--sm-subtitle-weight: {{ block.settings.subtitle_weight }};
--sm-description-weight: {{ block.settings.description_weight }};
--sm-button-weight: {{ block.settings.button_weight }};
--sm-benefit-weight: {{ block.settings.benefit_weight }};
--sm-mobile-benefits-display: {{ mobile_benefits_display }};
--sm-model-width: {{ block.settings.model_width }}%;
--sm-model-mobile-width: {{ block.settings.mobile_model_width }}%;
--sm-model-x: {{ block.settings.model_x }}%;
--sm-model-y: {{ block.settings.model_y }}%;
--sm-mobile-model-x: {{ block.settings.mobile_model_x }}%;
--sm-mobile-model-y: {{ block.settings.mobile_model_y }}%;
--sm-button-bg: {{ block.settings.button_background }};
--sm-button-text: {{ block.settings.button_text_color }};
--sm-button-border: {{ block.settings.button_border_color }};
--sm-button-radius: {{ block.settings.button_radius }}px;
--sm-button-align: {{ block.settings.button_desktop_position }};
--sm-button-width: {{ block.settings.button_desktop_width }}px;
--sm-button-size: {{ block.settings.button_desktop_size }}px;
--sm-mobile-button-width: {{ block.settings.mobile_button_width }}px;
--sm-mobile-button-size: {{ block.settings.mobile_button_size }}px;
--sm-mobile-button-height: {{ block.settings.mobile_button_height }}px;
--sm-secondary-text: {{ block.settings.secondary_button_text_color }};
--sm-secondary-border: {{ block.settings.secondary_button_border_color }};
--sm-benefit-icon-size: {{ block.settings.benefit_icon_size }}px;
"
data-scroll-effect="{{ block.settings.scroll_effect }}"
{{ block.shopify_attributes }}
>
<div class="sm-bg">
{% if block.settings.background_image != blank or block.settings.mobile_background_image != blank %}
<picture>
{% if block.settings.mobile_background_image != blank %}<source media="(max-width: 749px)" srcset="{{ block.settings.mobile_background_image | image_url: width: 1200 }}">{% endif %}
{% if block.settings.background_image != blank %}
{{ block.settings.background_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '900,1400,1800,2400', sizes: '100vw', alt: block.settings.title }}
{% else %}
{{ block.settings.mobile_background_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: block.settings.title }}
{% endif %}
</picture>
{% endif %}
</div>
<div class="sm-overlay"></div>
{% if block.settings.model_image != blank or block.settings.mobile_model_image != blank %}
<picture class="sm-model sm-animate--{{ block.settings.model_animation }}">
{% if block.settings.mobile_model_image != blank %}<source media="(max-width: 749px)" srcset="{{ block.settings.mobile_model_image | image_url: width: 900 }}">{% endif %}
{% assign model_alt = block.settings.model_alt | default: block.settings.title %}
{% if block.settings.model_image != blank %}
{{ block.settings.model_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '500,800,1100,1400', sizes: '(max-width: 749px) 80vw, 42vw', alt: model_alt }}
{% else %}
{{ block.settings.mobile_model_image | image_url: width: 900 | image_tag: loading: 'eager', alt: model_alt }}
{% endif %}
</picture>
{% endif %}
<div class="sm-inner">
<div class="sm-copy sm-copy--{{ block.settings.text_position }}">
<div class="sm-copy-top">
{% if block.settings.kicker != blank %}<p class="sm-kicker">{{ block.settings.kicker }}</p>{% endif %}
{% if block.settings.title != blank %}
<h2 class="sm-title">{{ block.settings.title }}{% if block.settings.highlight != blank %} <span>{{ block.settings.highlight }}</span>{% endif %}</h2>
{% endif %}
</div>
<div class="sm-copy-bottom">
{% if block.settings.subtitle != blank %}<p class="sm-subtitle">{{ block.settings.subtitle }}</p>{% endif %}
{% if block.settings.description != blank %}<div class="sm-description">{{ block.settings.description }}</div>{% endif %}
{% if block.settings.primary_label != blank or block.settings.secondary_label != blank %}
{% assign primary_action = block.settings.primary_link | strip %}
{% assign secondary_action = block.settings.secondary_link | strip %}
{% assign primary_is_popup = false %}
{% assign secondary_is_popup = false %}
{% if primary_action contains '<' %}{% assign primary_is_popup = true %}{% endif %}
{% if secondary_action contains '<' %}{% assign secondary_is_popup = true %}{% endif %}
<div class="sm-actions">
{% if block.settings.primary_label != blank and primary_action != blank %}
{% if primary_is_popup %}
<button class="sm-button sm-button--primary" type="button" data-sm-popup-open="primary-{{ block.id }}" data-sm-popup-html="{{ primary_action | escape }}">{{ block.settings.primary_label }}</button>
{% else %}
<a class="sm-button sm-button--primary" href="{{ primary_action }}">{{ block.settings.primary_label }}</a>
{% endif %}
{% endif %}
{% if block.settings.secondary_label != blank and secondary_action != blank %}
{% if secondary_is_popup %}
<button class="sm-button sm-button--secondary" type="button" data-sm-popup-open="secondary-{{ block.id }}" data-sm-popup-html="{{ secondary_action | escape }}">{{ block.settings.secondary_label }}</button>
{% else %}
<a class="sm-button sm-button--secondary" href="{{ secondary_action }}">{{ block.settings.secondary_label }}</a>
{% endif %}
{% endif %}
</div>
{% endif %}
{% if block.settings.benefit_1 != blank or block.settings.benefit_2 != blank or block.settings.benefit_3 != blank %}
<div class="sm-benefits">
{% if block.settings.benefit_1 != blank %}
{% assign benefit_1_icon = block.settings.benefit_1_icon | strip %}
<span>
{% if benefit_1_icon != blank and benefit_1_icon != 'none' %}<span class="sm-benefit-icon" data-lucide="{{ benefit_1_icon | escape }}" aria-hidden="true"></span>{% endif %}
<span class="sm-benefit-label">{{ block.settings.benefit_1 }}</span>
</span>
{% endif %}
{% if block.settings.benefit_2 != blank %}
{% assign benefit_2_icon = block.settings.benefit_2_icon | strip %}
<span>
{% if benefit_2_icon != blank and benefit_2_icon != 'none' %}<span class="sm-benefit-icon" data-lucide="{{ benefit_2_icon | escape }}" aria-hidden="true"></span>{% endif %}
<span class="sm-benefit-label">{{ block.settings.benefit_2 }}</span>
</span>
{% endif %}
{% if block.settings.benefit_3 != blank %}
{% assign benefit_3_icon = block.settings.benefit_3_icon | strip %}
<span>
{% if benefit_3_icon != blank and benefit_3_icon != 'none' %}<span class="sm-benefit-icon" data-lucide="{{ benefit_3_icon | escape }}" aria-hidden="true"></span>{% endif %}
<span class="sm-benefit-label">{{ block.settings.benefit_3 }}</span>
</span>
{% endif %}
</div>
{% endif %}
</div>
</div>
</div>
</section>
{% elsif request.design_mode %}
<div class="paradise-maison-slider-placeholder" {{ block.shopify_attributes }}>
<strong>Banner Ora disattivato</strong>
<span>Attiva il banner e carica sfondo, modello PNG e testi.</span>
</div>
{% endif %}
{% schema %}
{
"name": "Banner Ora",
"target": "section",
"stylesheet": "maison-slider.css",
"javascript": "maison-slider.js",
"settings": [
{"type":"checkbox","id":"enabled","label":"Mostra banner","default":true},
{"type":"header","content":"01 - Sfondo e struttura"},
{"type":"color","id":"background_color","label":"Colore sfondo","default":"#351054"},
{"type":"image_picker","id":"background_image","label":"Immagine sfondo desktop"},
{"type":"image_picker","id":"mobile_background_image","label":"Immagine sfondo mobile"},
{"type":"color","id":"overlay_color","label":"Colore overlay","default":"#000000"},
{"type":"range","id":"overlay_opacity","min":0,"max":70,"step":5,"unit":"%","label":"Trasparenza overlay","default":10},
{"type":"range","id":"desktop_height","min":380,"max":1000,"step":20,"unit":"px","label":"Altezza desktop","default":720},
{"type":"range","id":"mobile_height","min":520,"max":980,"step":20,"unit":"px","label":"Altezza mobile","default":760},
{"type":"select","id":"scroll_effect","label":"Effetto scroll","default":"soft","options":[{"value":"none","label":"Nessuno"},{"value":"soft","label":"Soft luxury"},{"value":"parallax","label":"Parallax"},{"value":"depth","label":"Profondita"}]},
{"type":"header","content":"02 - Modello PNG"},
{"type":"image_picker","id":"model_image","label":"Modello desktop PNG"},
{"type":"image_picker","id":"mobile_model_image","label":"Modello mobile PNG"},
{"type":"select","id":"model_side","label":"Posizione modello desktop","default":"left","options":[{"value":"left","label":"Sinistra"},{"value":"right","label":"Destra"}]},
{"type":"range","id":"model_width","min":24,"max":62,"step":2,"unit":"%","label":"Larghezza modello desktop","default":40},
{"type":"range","id":"model_x","min":-20,"max":40,"step":2,"unit":"%","label":"Modello X desktop","default":0},
{"type":"range","id":"model_y","min":-30,"max":30,"step":2,"unit":"%","label":"Modello Y desktop","default":0},
{"type":"range","id":"mobile_model_width","min":45,"max":100,"step":5,"unit":"%","label":"Larghezza modello mobile","default":80},
{"type":"select","id":"mobile_model_position","label":"Posizione modello mobile","default":"overlay","options":[{"value":"overlay","label":"Sovrapposto"},{"value":"above","label":"Sopra testo"},{"value":"below","label":"Sotto testo"}]},
{"type":"range","id":"mobile_model_x","min":-30,"max":30,"step":2,"unit":"%","label":"Modello X mobile","default":0},
{"type":"range","id":"mobile_model_y","min":-40,"max":40,"step":2,"unit":"%","label":"Modello Y mobile","default":0},
{"type":"select","id":"model_animation","label":"Animazione modello","default":"float","options":[{"value":"none","label":"Nessuna"},{"value":"float","label":"Float luxury"},{"value":"fade","label":"Fade in"},{"value":"zoom","label":"Zoom soft"}]},
{"type":"header","content":"03 - Testi e posizione"},
{"type":"text","id":"kicker","label":"Sopratitolo / piccolo testo sopra","default":"Corsi online estetici riconosciuti"},
{"type":"text","id":"title","label":"Titolo principale","default":"Diventa l'estetista che le clienti"},
{"type":"text","id":"highlight","label":"Parola evidenziata nel titolo","default":"scelgono,"},
{"type":"text","id":"subtitle","label":"Sottotitolo / frase sotto titolo","default":"non quella che costa meno."},
{"type":"richtext","id":"description","label":"Descrizione / testo piccolo","default":"<p>Docente digitale + supporto reale. Solo qui.</p>"},
{"type":"select","id":"text_position","label":"Allineamento testo desktop","default":"right","options":[{"value":"left","label":"Sinistra"},{"value":"center","label":"Centro"},{"value":"right","label":"Destra"}]},
{"type":"select","id":"mobile_copy_flow","label":"Composizione testo mobile","default":"together","options":[{"value":"together","label":"Tutto insieme"},{"value":"split","label":"Titolo sopra immagine"}]},
{"type":"range","id":"content_width","min":420,"max":980,"step":20,"unit":"px","label":"Larghezza blocco testo desktop","default":820},
{"type":"range","id":"layout_scale","min":70,"max":110,"step":5,"unit":"%","label":"Scala layout","default":100},
{"type":"range","id":"text_x","min":-30,"max":30,"step":2,"unit":"%","label":"Testo X desktop","default":0},
{"type":"range","id":"text_y","min":-30,"max":30,"step":2,"unit":"%","label":"Testo Y desktop","default":0},
{"type":"range","id":"mobile_text_x","min":-30,"max":30,"step":2,"unit":"%","label":"Testo X mobile","default":0},
{"type":"range","id":"mobile_text_y","min":-30,"max":30,"step":2,"unit":"%","label":"Testo Y mobile","default":0},
{"type":"range","id":"bottom_text_x","min":-40,"max":40,"step":2,"unit":"%","label":"Sottotitolo/descrizione X desktop","default":0},
{"type":"range","id":"bottom_text_y","min":-40,"max":40,"step":2,"unit":"%","label":"Sottotitolo/descrizione Y desktop","default":0},
{"type":"range","id":"mobile_bottom_text_x","min":-40,"max":40,"step":2,"unit":"%","label":"Sottotitolo/descrizione X mobile","default":0},
{"type":"range","id":"mobile_bottom_text_y","min":-40,"max":40,"step":2,"unit":"%","label":"Sottotitolo/descrizione Y mobile","default":0},
{"type":"select","id":"kicker_weight","label":"Peso sopratitolo","default":"700","options":[{"value":"400","label":"Normale"},{"value":"500","label":"Medio"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"},{"value":"800","label":"Extra bold"},{"value":"900","label":"Black"}]},
{"type":"select","id":"title_weight","label":"Peso titolo","default":"900","options":[{"value":"400","label":"Normale"},{"value":"500","label":"Medio"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"},{"value":"800","label":"Extra bold"},{"value":"900","label":"Black"}]},
{"type":"select","id":"subtitle_weight","label":"Peso sottotitolo","default":"800","options":[{"value":"400","label":"Normale"},{"value":"500","label":"Medio"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"},{"value":"800","label":"Extra bold"},{"value":"900","label":"Black"}]},
{"type":"select","id":"description_weight","label":"Peso descrizione","default":"600","options":[{"value":"400","label":"Normale"},{"value":"500","label":"Medio"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"},{"value":"800","label":"Extra bold"},{"value":"900","label":"Black"}]},
{"type":"range","id":"title_size","min":38,"max":110,"step":2,"unit":"px","label":"Titolo desktop","default":76},
{"type":"range","id":"mobile_title_size","min":30,"max":62,"step":2,"unit":"px","label":"Titolo mobile","default":42},
{"type":"range","id":"title_line_height","min":85,"max":130,"step":5,"unit":"%","label":"Interlinea titolo","default":110},
{"type":"range","id":"text_gap","min":0,"max":80,"step":4,"unit":"px","label":"Spazio tra testi desktop","default":24},
{"type":"range","id":"mobile_text_gap","min":0,"max":60,"step":4,"unit":"px","label":"Spazio tra testi mobile","default":20},
{"type":"color","id":"text_color","label":"Colore testo","default":"#ffffff"},
{"type":"color","id":"accent_color","label":"Colore evidenziato","default":"#b985ff"},
{"type":"header","content":"04 - Bottoni"},
{"type":"text","id":"primary_label","label":"Bottone 1 - testo","default":"Scopri il percorso giusto per te"},
{"type":"text","id":"primary_link","label":"Bottone 1 - link o codice popup"},
{"type":"text","id":"secondary_label","label":"Bottone 2 - testo","default":"Guarda i corsi"},
{"type":"text","id":"secondary_link","label":"Bottone 2 - link o codice popup"},
{"type":"select","id":"button_desktop_position","label":"Posizione bottoni desktop","default":"flex-start","options":[{"value":"flex-start","label":"Sinistra"},{"value":"center","label":"Centro"},{"value":"flex-end","label":"Destra"}]},
{"type":"range","id":"button_desktop_width","min":140,"max":520,"step":20,"unit":"px","label":"Larghezza bottoni desktop","default":300},
{"type":"range","id":"button_desktop_size","min":11,"max":24,"step":1,"unit":"px","label":"Testo bottoni desktop","default":16},
{"type":"select","id":"mobile_button_layout","label":"Layout bottoni mobile","default":"stacked","options":[{"value":"stacked","label":"Uno sotto l'altro"},{"value":"inline","label":"Affiancati"},{"value":"full","label":"Pieni larghezza"}]},
{"type":"range","id":"mobile_button_width","min":120,"max":360,"step":10,"unit":"px","label":"Larghezza bottoni mobile","default":220},
{"type":"range","id":"mobile_button_size","min":10,"max":18,"step":1,"unit":"px","label":"Testo bottoni mobile","default":12},
{"type":"range","id":"mobile_button_height","min":38,"max":64,"step":2,"unit":"px","label":"Altezza bottoni mobile","default":46},
{"type":"select","id":"button_weight","label":"Peso bottoni","default":"800","options":[{"value":"400","label":"Normale"},{"value":"500","label":"Medio"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"},{"value":"800","label":"Extra bold"},{"value":"900","label":"Black"}]},
{"type":"color","id":"button_background","label":"Bottone 1 - sfondo","default":"#ff4f62"},
{"type":"color","id":"button_text_color","label":"Bottone 1 - testo","default":"#ffffff"},
{"type":"color","id":"button_border_color","label":"Bottone 1 - bordo","default":"#ff4f62"},
{"type":"color","id":"secondary_button_text_color","label":"Bottone 2 - testo","default":"#ffffff"},
{"type":"color","id":"secondary_button_border_color","label":"Bottone 2 - bordo","default":"#b985ff"},
{"type":"range","id":"button_radius","min":0,"max":40,"step":2,"unit":"px","label":"Angoli bottone","default":8},
{"type":"header","content":"05 - Benefit / icone"},
{"type":"checkbox","id":"show_benefits_mobile","label":"Mostra benefit su mobile","default":true},
{"type":"select","id":"benefit_weight","label":"Peso benefit","default":"600","options":[{"value":"400","label":"Normale"},{"value":"500","label":"Medio"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"},{"value":"800","label":"Extra bold"},{"value":"900","label":"Black"}]},
{"type":"range","id":"benefit_icon_size","min":6,"max":40,"step":1,"unit":"px","label":"Dimensione icone benefit","default":18},
{"type":"text","id":"benefit_1_icon","label":"Icona 1 - codice Lucide","default":"shield","info":"Scrivi solo il codice icona, per esempio credit-card, mouse-pointer, shield-check. Catalogo: lucide.dev/icons."},
{"type":"text","id":"benefit_1","label":"Testo benefit 1","default":"Corsi riconosciuti"},
{"type":"text","id":"benefit_2_icon","label":"Icona 2 - codice Lucide","default":"book","info":"Scrivi solo il codice icona, per esempio book, clock, graduation-cap."},
{"type":"text","id":"benefit_2","label":"Testo benefit 2","default":"Studia quando vuoi"},
{"type":"text","id":"benefit_3_icon","label":"Icona 3 - codice Lucide","default":"users","info":"Scrivi solo il codice icona, per esempio users, heart-handshake, badge-check."},
{"type":"text","id":"benefit_3","label":"Testo benefit 3","default":"Supporto reale"}
]
}
{% endschema %}
