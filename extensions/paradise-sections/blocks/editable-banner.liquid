{% assign section_id = 'slider-maison-' | append: block.id %}
{% if block.settings.enabled %}
<section
id="{{ section_id }}"
class="slider-maison slider-maison--{{ block.settings.layout }} slider-maison--model-{{ block.settings.model_side }} slider-maison--mobile-model-{{ block.settings.mobile_model_position }}"
style="
--sm-bg: {{ block.settings.background_color }};
--sm-text: {{ block.settings.text_color }};
--sm-accent: {{ block.settings.accent_color }};
--sm-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
--sm-height: {{ block.settings.desktop_height }}px;
--sm-mobile-height: {{ block.settings.mobile_height }}px;
--sm-radius: {{ block.settings.radius }}px;
--sm-title: {{ block.settings.title_size }}px;
--sm-mobile-title: {{ block.settings.mobile_title_size }}px;
--sm-title-line: {{ block.settings.title_line_height | divided_by: 100.0 }};
--sm-text-gap: {{ block.settings.text_gap }}px;
--sm-mobile-text-gap: {{ block.settings.mobile_text_gap }}px;
--sm-model-mobile-gap: {{ block.settings.mobile_model_gap }}px;
--sm-content-width: {{ block.settings.content_width }}px;
--sm-model-width: {{ block.settings.model_width }}%;
--sm-model-mobile-width: {{ block.settings.mobile_model_width }}%;
--sm-model-x: {{ block.settings.model_x }}%;
--sm-model-y: {{ block.settings.model_y }}%;
--sm-mobile-model-x: {{ block.settings.mobile_model_x }}%;
--sm-mobile-model-y: {{ block.settings.mobile_model_y }}%;
--sm-button-bg: {{ block.settings.button_background }};
--sm-button-text: {{ block.settings.button_text_color }};
--sm-button-border: {{ block.settings.button_border_color }};
--sm-button-radius: {{ block.settings.button_radius }}px;
--sm-secondary-text: {{ block.settings.secondary_button_text_color }};
--sm-secondary-border: {{ block.settings.secondary_button_border_color }};
"
{{ block.shopify_attributes }}
>
<div class="sm-bg">
{% if block.settings.background_image != blank or block.settings.mobile_background_image != blank %}
<picture>
{% if block.settings.mobile_background_image != blank %}<source media="(max-width: 749px)" srcset="{{ block.settings.mobile_background_image | image_url: width: 1200 }}">{% endif %}
{% if block.settings.background_image != blank %}
{{ block.settings.background_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '900,1400,1800,2400', sizes: '100vw', alt: block.settings.title }}
{% else %}
{{ block.settings.mobile_background_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: block.settings.title }}
{% endif %}
</picture>
{% endif %}
</div>
<div class="sm-overlay"></div>
{% if block.settings.model_image != blank or block.settings.mobile_model_image != blank %}
<picture class="sm-model sm-animate--{{ block.settings.model_animation }}">
{% if block.settings.mobile_model_image != blank %}<source media="(max-width: 749px)" srcset="{{ block.settings.mobile_model_image | image_url: width: 900 }}">{% endif %}
{% assign model_alt = block.settings.model_alt | default: block.settings.title %}
{% if block.settings.model_image != blank %}
{{ block.settings.model_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '500,800,1100,1400', sizes: '(max-width: 749px) 80vw, 42vw', alt: model_alt }}
{% else %}
{{ block.settings.mobile_model_image | image_url: width: 900 | image_tag: loading: 'eager', alt: model_alt }}
{% endif %}
</picture>
{% endif %}
<div class="sm-inner">
<div class="sm-copy sm-copy--{{ block.settings.text_position }}">
{% if block.settings.kicker != blank %}<p class="sm-kicker">{{ block.settings.kicker }}</p>{% endif %}
{% if block.settings.title != blank %}
<h2 class="sm-title">{{ block.settings.title }}{% if block.settings.highlight != blank %} <span>{{ block.settings.highlight }}</span>{% endif %}</h2>
{% endif %}
{% if block.settings.subtitle != blank %}<p class="sm-subtitle">{{ block.settings.subtitle }}</p>{% endif %}
{% if block.settings.description != blank %}<div class="sm-description">{{ block.settings.description }}</div>{% endif %}
{% if block.settings.primary_label != blank or block.settings.secondary_label != blank %}
<div class="sm-actions">
{% if block.settings.primary_label != blank and block.settings.primary_link != blank %}<a class="sm-button sm-button--primary" href="{{ block.settings.primary_link }}">{{ block.settings.primary_label }}</a>{% endif %}
{% if block.settings.secondary_label != blank and block.settings.secondary_link != blank %}<a class="sm-button sm-button--secondary" href="{{ block.settings.secondary_link }}">{{ block.settings.secondary_label }}</a>{% endif %}
</div>
{% endif %}
{% if block.settings.benefit_1 != blank or block.settings.benefit_2 != blank or block.settings.benefit_3 != blank %}
<div class="sm-benefits">
{% if block.settings.benefit_1 != blank %}<span>{{ block.settings.benefit_1 }}</span>{% endif %}
{% if block.settings.benefit_2 != blank %}<span>{{ block.settings.benefit_2 }}</span>{% endif %}
{% if block.settings.benefit_3 != blank %}<span>{{ block.settings.benefit_3 }}</span>{% endif %}
</div>
{% endif %}
</div>
</div>
</section>
{% elsif request.design_mode %}
<div class="paradise-maison-slider-placeholder" {{ block.shopify_attributes }}>
<strong>Banner Ora disattivato</strong>
<span>Attiva il banner e carica sfondo, modello PNG e testi.</span>
</div>
{% endif %}
{% schema %}
{
"name": "Banner Ora",
"target": "section",
"stylesheet": "maison-slider.css",
"settings": [
{"type":"checkbox","id":"enabled","label":"Mostra banner","default":true},
{"type":"header","content":"Sfondo"},
{"type":"color","id":"background_color","label":"Colore sfondo","default":"#351054"},
{"type":"image_picker","id":"background_image","label":"Immagine sfondo desktop"},
{"type":"image_picker","id":"mobile_background_image","label":"Immagine sfondo mobile"},
{"type":"range","id":"overlay_opacity","min":0,"max":70,"step":5,"unit":"%","label":"Overlay scuro","default":10},
{"type":"range","id":"desktop_height","min":380,"max":1000,"step":20,"unit":"px","label":"Altezza desktop","default":720},
{"type":"range","id":"mobile_height","min":520,"max":980,"step":20,"unit":"px","label":"Altezza mobile","default":760},
{"type":"range","id":"radius","min":0,"max":40,"step":2,"unit":"px","label":"Angoli banner","default":0},
{"type":"header","content":"Modello PNG"},
{"type":"image_picker","id":"model_image","label":"Modello desktop PNG"},
{"type":"image_picker","id":"mobile_model_image","label":"Modello mobile PNG"},
{"type":"text","id":"model_alt","label":"Alt modello","default":"Paradise model"},
{"type":"select","id":"model_side","label":"Posizione modello","default":"left","options":[{"value":"left","label":"Sinistra"},{"value":"right","label":"Destra"}]},
{"type":"range","id":"model_width","min":24,"max":62,"step":2,"unit":"%","label":"Larghezza modello desktop","default":40},
{"type":"range","id":"model_x","min":-20,"max":40,"step":2,"unit":"%","label":"Modello X desktop","default":0},
{"type":"range","id":"model_y","min":-30,"max":30,"step":2,"unit":"%","label":"Modello Y desktop","default":0},
{"type":"range","id":"mobile_model_width","min":45,"max":100,"step":5,"unit":"%","label":"Larghezza modello mobile","default":80},
{"type":"select","id":"mobile_model_position","label":"Modello mobile","default":"overlay","options":[{"value":"overlay","label":"Sovrapposto"},{"value":"above","label":"Sopra testo"},{"value":"below","label":"Sotto testo"}]},
{"type":"range","id":"mobile_model_x","min":-30,"max":30,"step":2,"unit":"%","label":"Modello X mobile","default":0},
{"type":"range","id":"mobile_model_y","min":-40,"max":40,"step":2,"unit":"%","label":"Modello Y mobile","default":0},
{"type":"range","id":"mobile_model_gap","min":0,"max":80,"step":4,"unit":"px","label":"Spazio modello/testo","default":20},
{"type":"select","id":"model_animation","label":"Animazione modello","default":"float","options":[{"value":"none","label":"Nessuna"},{"value":"float","label":"Float luxury"},{"value":"fade","label":"Fade in"},{"value":"zoom","label":"Zoom soft"}]},
{"type":"header","content":"Testi"},
{"type":"text","id":"kicker","label":"Sopratitolo","default":"Corsi online estetici riconosciuti"},
{"type":"text","id":"title","label":"Titolo","default":"Diventa l'estetista che le clienti"},
{"type":"text","id":"highlight","label":"Parola evidenziata","default":"scelgono,"},
{"type":"text","id":"subtitle","label":"Sottotitolo","default":"non quella che costa meno."},
{"type":"richtext","id":"description","label":"Descrizione","default":"<p>Docente digitale + supporto reale. Solo qui.</p>"},
{"type":"select","id":"text_position","label":"Posizione testo","default":"right","options":[{"value":"left","label":"Sinistra"},{"value":"center","label":"Centro"},{"value":"right","label":"Destra"}]},
{"type":"range","id":"content_width","min":420,"max":980,"step":20,"unit":"px","label":"Larghezza testo","default":820},
{"type":"range","id":"title_size","min":38,"max":110,"step":2,"unit":"px","label":"Titolo desktop","default":76},
{"type":"range","id":"mobile_title_size","min":30,"max":62,"step":2,"unit":"px","label":"Titolo mobile","default":42},
{"type":"range","id":"title_line_height","min":85,"max":130,"step":5,"unit":"%","label":"Interlinea titolo","default":110},
{"type":"range","id":"text_gap","min":0,"max":80,"step":4,"unit":"px","label":"Spazio tra testi desktop","default":24},
{"type":"range","id":"mobile_text_gap","min":0,"max":60,"step":4,"unit":"px","label":"Spazio tra testi mobile","default":20},
{"type":"color","id":"text_color","label":"Colore testo","default":"#ffffff"},
{"type":"color","id":"accent_color","label":"Colore evidenziato","default":"#b985ff"},
{"type":"header","content":"Bottoni"},
{"type":"text","id":"primary_label","label":"Testo bottone principale","default":"Scopri il percorso giusto per te"},
{"type":"url","id":"primary_link","label":"Link bottone principale"},
{"type":"text","id":"secondary_label","label":"Testo bottone secondario","default":"Guarda i corsi"},
{"type":"url","id":"secondary_link","label":"Link bottone secondario"},
{"type":"color","id":"button_background","label":"Sfondo bottone","default":"#ff4f62"},
{"type":"color","id":"button_text_color","label":"Testo bottone","default":"#ffffff"},
{"type":"color","id":"button_border_color","label":"Bordo bottone","default":"#ff4f62"},
{"type":"color","id":"secondary_button_text_color","label":"Testo bottone secondario","default":"#ffffff"},
{"type":"color","id":"secondary_button_border_color","label":"Bordo bottone secondario","default":"#b985ff"},
{"type":"range","id":"button_radius","min":0,"max":40,"step":2,"unit":"px","label":"Angoli bottone","default":8},
{"type":"header","content":"Benefit"},
{"type":"text","id":"benefit_1","label":"Benefit 1","default":"Corsi riconosciuti"},
{"type":"text","id":"benefit_2","label":"Benefit 2","default":"Studia quando vuoi"},
{"type":"text","id":"benefit_3","label":"Benefit 3","default":"Supporto reale"}
]
}
{% endschema %}
