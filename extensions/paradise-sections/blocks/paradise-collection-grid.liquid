{{ 'paradise-adv-slot.css' | asset_url | stylesheet_tag }}
<script src="{{ 'paradise-collection-grid.js' | asset_url }}" defer></script>
{% assign grid_collection = blank %}
{% if block.settings.use_current_collection and collection != blank %}
{% assign grid_collection = collection %}
{% elsif block.settings.collection != blank %}
{% assign grid_collection = block.settings.collection %}
{% endif %}
{% assign adv_slot_code = block.settings.adv_slot_code %}
{% assign collection_slot_code = blank %}
{% if block.settings.use_collection_campaign and grid_collection.handle != blank %}
{% assign collection_slot_code = 'collection-' | append: grid_collection.handle %}
{% endif %}
{% assign resolved_slot_code = collection_slot_code | default: adv_slot_code %}
{% assign global_campaign = blank %}
{% if block.settings.show_adv and block.settings.use_global_campaign %}
{% if collection_slot_code != blank %}
{% assign global_campaign = shop.metaobjects.paradise_adv_campaign[collection_slot_code] %}
{% endif %}
{% if global_campaign == blank and adv_slot_code != blank %}
{% assign global_campaign = shop.metaobjects.paradise_adv_campaign[adv_slot_code] %}
{% assign resolved_slot_code = adv_slot_code %}
{% endif %}
{% endif %}
{% assign has_global_campaign = false %}
{% if global_campaign != blank %}
{% assign has_global_campaign = true %}
{% endif %}
{% assign global_campaign_active = true %}
{% if global_campaign.is_active.value == false or global_campaign.is_active.value == 'false' %}
{% assign global_campaign_active = false %}
{% endif %}
{% assign now_timestamp = 'now' | date: '%s' | plus: 0 %}
{% if global_campaign.starts_at.value != blank %}
{% assign start_timestamp = global_campaign.starts_at.value | date: '%s' | plus: 0 %}
{% if now_timestamp < start_timestamp %}
{% assign global_campaign_active = false %}
{% endif %}
{% endif %}
{% if global_campaign.ends_at.value != blank %}
{% assign end_timestamp = global_campaign.ends_at.value | date: '%s' | plus: 0 %}
{% if now_timestamp > end_timestamp %}
{% assign global_campaign_active = false %}
{% endif %}
{% endif %}
{% assign global_desktop_image = global_campaign.desktop_image.value %}
{% assign global_mobile_image = global_campaign.mobile_image.value | default: global_desktop_image %}
{% assign global_kicker = global_campaign.kicker.value %}
{% assign global_title = global_campaign.title.value %}
{% assign global_text = global_campaign.text.value %}
{% assign global_button_label = global_campaign.button_label.value %}
{% assign global_button_link = global_campaign.button_link_url.value %}
{% assign global_link_behavior = global_campaign.link_behavior.value | default: 'image' %}
{% assign global_image_format = global_campaign.image_format.value | default: 'collection-portrait' %}
{% assign global_accessibility_label = global_campaign.accessibility_label.value %}
{% assign global_desktop_image_position = global_campaign.desktop_image_position.value | default: 'center center' %}
{% assign global_mobile_image_position = global_campaign.mobile_image_position.value | default: global_desktop_image_position %}
{% assign global_overlay_opacity = global_campaign.overlay_opacity.value | default: 20 %}
{% assign global_card_radius = global_campaign.card_radius.value | default: 8 %}
{% assign global_content_max_width = global_campaign.content_max_width.value | default: 520 %}
{% assign global_text_color = global_campaign.text_color.value | default: '#ffffff' %}
{% assign global_button_background = global_campaign.button_background.value | default: '#ffffff' %}
{% assign global_button_background_opacity = global_campaign.button_background_opacity.value | default: 100 %}
{% if global_button_label != blank and global_button_background_opacity == '0' %}
{% assign global_button_background_opacity = 100 %}
{% endif %}
{% assign global_button_text_color = global_campaign.button_text_color.value | default: '#171313' %}
{% assign global_button_border_color = global_campaign.button_border_color.value | default: '#ffffff' %}
{% assign global_button_hover_background = global_campaign.button_hover_background.value | default: '#171313' %}
{% assign global_button_hover_text_color = global_campaign.button_hover_text_color.value | default: '#ffffff' %}
{% assign global_button_radius = global_campaign.button_radius.value | default: 18 %}
{% assign global_text_position_raw = global_campaign.text_position.value | downcase | strip %}
{% assign global_text_position_x = global_campaign.text_position_x.value | default: 18 %}
{% assign global_text_position_y = global_campaign.text_position_y.value | default: 72 %}
{% assign global_mobile_text_position_x = global_campaign.mobile_text_position_x.value | default: global_text_position_x %}
{% assign global_mobile_text_position_y = global_campaign.mobile_text_position_y.value | default: global_text_position_y %}
{% assign adv_position = 'bottom-left' %}
{% if global_text_position_raw != blank %}
{% case global_text_position_raw %}
{% when 'custom', 'libera', 'free', 'drag' %}
{% assign adv_position = 'custom' %}
{% when 'destra', 'right', 'basso destra', 'bottom-right', 'bottom right' %}
{% assign adv_position = 'bottom-right' %}
{% when 'centro', 'center', 'basso centro', 'bottom-center', 'bottom center' %}
{% assign adv_position = 'bottom-center' %}
{% when 'alto destra', 'top-right', 'top right' %}
{% assign adv_position = 'top-right' %}
{% when 'alto centro', 'top-center', 'top center' %}
{% assign adv_position = 'top-center' %}
{% when 'alto sinistra', 'top-left', 'top left' %}
{% assign adv_position = 'top-left' %}
{% when 'nascosto', 'hidden', 'solo immagine' %}
{% assign adv_position = 'hidden' %}
{% endcase %}
{% endif %}
{% assign can_render_adv = false %}
{% if block.settings.show_adv and has_global_campaign and global_campaign_active and global_desktop_image != blank %}
{% assign can_render_adv = true %}
{% endif %}
{% assign adv_has_copy = false %}
{% if global_kicker != blank or global_title != blank or global_text != blank or global_button_label != blank %}
{% assign adv_has_copy = true %}
{% endif %}
{% assign adv_alt = global_accessibility_label | default: global_title | default: resolved_slot_code %}
{% assign adv_image_ratio = 100 %}
{% case global_image_format %}
{% when 'collection-square' %}
{% assign adv_image_ratio = 100 %}
{% when 'collection-portrait' %}
{% assign adv_image_ratio = 100 %}
{% when 'mobile-story' %}
{% assign adv_image_ratio = 178 %}
{% endcase %}
{% assign should_render_adv = false %}
{% if can_render_adv %}
{% assign should_render_adv = true %}
{% elsif request.design_mode and block.settings.show_adv %}
{% assign should_render_adv = true %}
{% endif %}
{% assign adv_hidden_initial = false %}
{% if block.settings.enable_load_more and 4 > block.settings.initial_visible_products %}
{% assign adv_hidden_initial = true %}
{% endif %}
{% assign adv_carousel_codes = block.settings.adv_slot_codes | strip %}
{% assign has_adv_carousel = false %}
{% if block.settings.show_adv and block.settings.use_global_campaign and adv_carousel_codes != blank %}
{% assign has_adv_carousel = true %}
{% endif %}
{% capture paradise_adv_card %}
{% if has_adv_carousel %}
{% assign carousel_codes = resolved_slot_code | append: ',' | append: adv_carousel_codes %}
{% assign carousel_code_items = carousel_codes | split: ',' %}
<div class="pcg-adv-card{% if adv_hidden_initial %} pcg-product-card--hidden{% endif %}">
<div class="pcg-adv-carousel pcg-adv-carousel--{{ block.settings.adv_animation }}" data-adv-carousel data-interval="{{ block.settings.adv_interval }}" style="--pcg-adv-ratio:100%;">
<span class="pcg-adv-disclosure">ADV</span>
{% for code_item in carousel_code_items %}
{% assign code_handle = code_item | strip %}
{% assign carousel_campaign = shop.metaobjects.paradise_adv_campaign[code_handle] %}
{% assign carousel_active = true %}
{% if carousel_campaign.is_active.value == false or carousel_campaign.is_active.value == 'false' %}{% assign carousel_active = false %}{% endif %}
{% if carousel_campaign.starts_at.value != blank %}{% assign carousel_start = carousel_campaign.starts_at.value | date: '%s' | plus: 0 %}{% if now_timestamp < carousel_start %}{% assign carousel_active = false %}{% endif %}{% endif %}
{% if carousel_campaign.ends_at.value != blank %}{% assign carousel_end = carousel_campaign.ends_at.value | date: '%s' | plus: 0 %}{% if now_timestamp > carousel_end %}{% assign carousel_active = false %}{% endif %}{% endif %}
{% assign carousel_image = carousel_campaign.desktop_image.value %}
{% assign carousel_mobile = carousel_campaign.mobile_image.value | default: carousel_image %}
{% if carousel_active and carousel_image != blank %}
<a class="pcg-adv-slide{% if forloop.first %} is-active{% endif %}" href="{{ carousel_campaign.button_link_url.value | default: '#' }}">
<picture>{% if carousel_mobile != blank %}<source media="(max-width:749px)" srcset="{{ carousel_mobile | image_url: width: 900 }}">{% endif %}{{ carousel_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: carousel_campaign.title.value }}</picture>
</a>
{% endif %}
{% endfor %}
</div>
</div>
{% elsif can_render_adv %}
<div class="pcg-adv-card{% if adv_hidden_initial %} pcg-product-card--hidden{% endif %}" data-adv-slot="{{ resolved_slot_code | escape }}">
<section
class="paradise-adv-slot paradise-adv-slot--{{ adv_position }}"
style="
--pcg-adv-ratio: {{ adv_image_ratio }}%;
--pas-height: 520px;
--pas-mobile-height: 420px;
--pas-image-position: {{ global_desktop_image_position }};
--pas-mobile-image-position: {{ global_mobile_image_position }};
--pas-overlay-opacity: {{ global_overlay_opacity | divided_by: 100.0 }};
--pas-radius: {{ global_card_radius }}px;
--pas-content-width: {{ global_content_max_width }}px;
--pas-text: {{ global_text_color }};
--pas-button-bg-color: {{ global_button_background }};
--pas-button-bg-opacity-percent: {{ global_button_background_opacity }}%;
--pas-button-text: {{ global_button_text_color }};
--pas-button-border: {{ global_button_border_color }};
--pas-button-hover-bg: {{ global_button_hover_background }};
--pas-button-hover-text: {{ global_button_hover_text_color }};
--pas-button-radius: {{ global_button_radius }}px;
--pas-padding-top: 0px;
--pas-padding-bottom: 0px;
--pas-mobile-padding-top: 0px;
--pas-mobile-padding-bottom: 0px;
--pas-text-x: {{ global_text_position_x }}%;
--pas-text-y: {{ global_text_position_y }}%;
--pas-mobile-text-x: {{ global_mobile_text_position_x }}%;
--pas-mobile-text-y: {{ global_mobile_text_position_y }}%;
"
>
{% if global_button_link != blank and global_link_behavior != 'button' %}
<a class="pas-frame" href="{{ global_button_link }}" aria-label="{{ adv_alt | escape }}">
{% else %}
<div class="pas-frame pas-frame--static" role="img" aria-label="{{ adv_alt | escape }}">
{% endif %}
<span class="pcg-adv-disclosure">ADV</span>
<picture class="pas-picture">
{% if global_mobile_image != blank %}
<source media="(max-width: 749px)" srcset="{{ global_mobile_image | image_url: width: 1000 }}">
{% endif %}
{{ global_desktop_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '450, 700, 900, 1200, 1600', sizes: '(max-width: 749px) 100vw, 50vw', alt: adv_alt }}
</picture>
<div class="pas-overlay" aria-hidden="true"></div>
{% if adv_has_copy %}
<div class="pas-content">
<div class="pas-copy">
{% if global_kicker != blank %}<p class="pas-kicker">{{ global_kicker }}</p>{% endif %}
{% if global_title != blank %}<h2 class="pas-title">{{ global_title }}</h2>{% endif %}
{% if global_text != blank %}<div class="pas-text">{{ global_text | newline_to_br }}</div>{% endif %}
{% if global_button_label != blank %}
{% if global_button_link != blank and global_link_behavior == 'button' %}
<a class="pas-button" href="{{ global_button_link }}">{{ global_button_label }}</a>
{% else %}
<span class="pas-button" role="button">{{ global_button_label }}</span>
{% endif %}
{% endif %}
</div>
</div>
{% endif %}
{% if global_button_link != blank and global_link_behavior != 'button' %}
</a>
{% else %}
</div>
{% endif %}
</section>
</div>
{% elsif request.design_mode and block.settings.show_adv %}
<div class="pcg-adv-card">
<div class="paradise-adv-slot-placeholder">
<strong>ADV non trovata</strong>
<span>{{ resolved_slot_code | default: 'collection-handle' }}</span>
</div>
</div>
{% endif %}
{% endcapture %}
<section
class="paradise-collection-grid"
style="
--pcg-max-width: none;
--pcg-side-padding: 24px;
--pcg-mobile-side-padding: 6px;
--pcg-columns: {{ block.settings.desktop_columns }};
--pcg-mobile-columns: {{ block.settings.mobile_columns }};
--pcg-gap: 24px;
--pcg-mobile-gap: 8px;
--pcg-radius: 8px;
--pcg-product-ratio: 100%;
--pcg-heading-align: {{ block.settings.heading_alignment }};
--pcg-padding-top: 32px;
--pcg-padding-bottom: 32px;
--pcg-mobile-padding-top: 20px;
--pcg-mobile-padding-bottom: 20px;
--pcg-adv-span: 1;
--pcg-mobile-adv-span: 1;
--pcg-adv-height: 520px;
--pcg-mobile-adv-height: 420px;
--pcg-card-bg: {{ block.settings.product_card_background }};
--pcg-card-border: {{ block.settings.product_card_border }};
--pcg-sale-bg: {{ block.settings.discount_badge_background }};
--pcg-sale-text: {{ block.settings.discount_badge_text_color }};
--pcg-sale-radius: {{ block.settings.discount_badge_radius }}px;
--pcg-sale-size: {{ block.settings.discount_badge_font_size }}px;
--pcg-image-fit: {{ block.settings.product_image_fit }};
--pcg-image-bg: {{ block.settings.product_image_background }};
--pcg-image-padding: {{ block.settings.product_image_padding }}px;
--pcg-image-scale: {{ block.settings.product_image_scale | divided_by: 100.0 }};
--pcg-image-position: {{ block.settings.product_image_position }};
--pcg-text-align: {{ block.settings.product_text_alignment }};
--pcg-text-justify: {% if block.settings.product_text_alignment == 'center' %}center{% elsif block.settings.product_text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
--pcg-title-color: {{ block.settings.product_title_color }};
--pcg-title-size: {{ block.settings.product_title_size }}px;
--pcg-title-weight: {{ block.settings.product_title_weight }};
--pcg-title-family: {{ block.settings.product_title_font }};
--pcg-vendor-color: {{ block.settings.product_vendor_color }};
--pcg-price-color: {{ block.settings.product_price_color }};
--pcg-compare-color: {{ block.settings.product_compare_price_color }};
--pcg-rating-filled: {{ block.settings.rating_star_color }};
--pcg-rating-empty: {{ block.settings.rating_empty_star_color }};
--pcg-rating-text: {{ block.settings.rating_text_color }};
--pcg-quick-border: {{ block.settings.quick_add_border_color }};
--pcg-quick-bg: {{ block.settings.quick_add_background }};
--pcg-quick-text: {{ block.settings.quick_add_text_color }};
--pcg-quick-hover-bg: {{ block.settings.quick_add_hover_background }};
--pcg-quick-hover-text: {{ block.settings.quick_add_hover_text_color }};
"
{{ block.shopify_attributes }}
>
<div class="pcg-inner">
{% if block.settings.kicker != blank or block.settings.heading != blank %}
<div class="pcg-heading">
{% if block.settings.kicker != blank %}<p>{{ block.settings.kicker }}</p>{% endif %}
{% if block.settings.heading != blank %}<h2>{{ block.settings.heading }}</h2>{% endif %}
</div>
{% endif %}
{% if grid_collection != blank and grid_collection.products_count > 0 %}
{% assign adv_rendered = false %}
{% paginate grid_collection.products by 250 %}
{% if block.settings.show_view_toolbar %}
<div class="pcg-toolbar" data-grid-toolbar>
<div class="pcg-view-buttons" aria-label="Cambia vista prodotti">
<button class="pcg-view-btn pcg-view-btn--mobile{% if block.settings.mobile_columns == '1' %} is-active{% endif %}" type="button" data-grid-columns="1" aria-label="1 prodotto per riga">
<span></span>
</button>
<button class="pcg-view-btn pcg-view-btn--mobile{% if block.settings.mobile_columns == '2' %} is-active{% endif %}" type="button" data-grid-columns="2" aria-label="2 prodotti per riga">
<span></span><span></span>
</button>
<button class="pcg-view-btn pcg-view-btn--desktop{% if block.settings.desktop_columns == '3' %} is-active{% endif %}" type="button" data-grid-columns="3" aria-label="3 prodotti per riga">
<span></span><span></span><span></span>
</button>
<button class="pcg-view-btn pcg-view-btn--desktop{% if block.settings.desktop_columns == '4' %} is-active{% endif %}" type="button" data-grid-columns="4" aria-label="4 prodotti per riga">
<span></span><span></span><span></span><span></span>
</button>
</div>
<p class="pcg-product-count">{{ grid_collection.products_count }} prodotti</p>
</div>
{% endif %}
<div class="pcg-grid">
{% for product in grid_collection.products %}
{% assign product_number = forloop.index %}
{% assign product_variant = product.selected_or_first_available_variant %}
<article class="pcg-product-card{% if block.settings.enable_load_more and product_number > block.settings.initial_visible_products %} pcg-product-card--hidden{% endif %}" data-product-card>
<a class="pcg-product-media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
{% if block.settings.show_discount_badge and product.compare_at_price > product.price %}
{% assign discount_amount = product.compare_at_price | minus: product.price %}
{% assign discount_percent = discount_amount | times: 100 | divided_by: product.compare_at_price %}
<span class="pcg-sale-badge pcg-sale-badge--{{ block.settings.discount_badge_position }}">
{% if block.settings.discount_badge_label != blank %}
{{ block.settings.discount_badge_label }}
{% else %}
-{{ discount_percent }}%
{% endif %}
</span>
{% endif %}
{% if product.featured_image != blank %}
{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 750, 900', sizes: '(max-width: 749px) 50vw, 25vw', alt: product.title, class: 'pcg-product-img pcg-product-img--primary' }}
{% if block.settings.show_hover_image and product.images.size > 1 %}
{% assign hover_image = product.images[1] %}
{{ hover_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 750, 900', sizes: '(max-width: 749px) 50vw, 25vw', alt: product.title, class: 'pcg-product-img pcg-product-img--hover' }}
{% endif %}
{% endif %}
</a>
<span class="pcg-product-info">
<span class="pcg-product-copy">
{% if block.settings.show_vendor and product.vendor != blank %}
<span class="pcg-product-vendor">{{ product.vendor }}</span>
{% endif %}
<a class="pcg-product-title" href="{{ product.url }}">{{ product.title }}</a>
</span>
{% if block.settings.show_rating %}
<span class="pcg-rating" aria-label="{{ block.settings.rating_value }} stelle su 5">
<span class="pcg-stars" aria-hidden="true">
{% for star_index in (1..5) %}
<span class="{% if star_index <= block.settings.rating_value %}is-filled{% endif %}">★</span>
{% endfor %}
</span>
{% if block.settings.rating_review_count != blank %}
<span class="pcg-review-count">({{ block.settings.rating_review_count }})</span>
{% endif %}
</span>
{% endif %}
{% if block.settings.show_price %}
<span class="pcg-product-price">
{% if product.compare_at_price > product.price %}
<span class="pcg-product-compare">{{ product.compare_at_price | money }}</span>
{% endif %}
{{ product.price | money }}
</span>
{% endif %}
{% if block.settings.show_quick_add %}
<form
class="pcg-quick-add"
action="{{ routes.cart_add_url }}"
method="post"
data-quick-add
data-price="{{ product_variant.price }}"
data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
>
<input type="hidden" name="id" value="{{ product_variant.id }}">
<div class="pcg-quantity" aria-label="Quantita">
<button type="button" class="pcg-qty-btn" data-qty-minus aria-label="Riduci quantita">-</button>
<input class="pcg-qty-input" type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric" data-qty-input aria-label="Quantita">
<button type="button" class="pcg-qty-btn" data-qty-plus aria-label="Aumenta quantita">+</button>
</div>
<button
type="submit"
class="pcg-cart-button"
data-cart-button
{% unless product_variant.available %}disabled{% endunless %}
>
{% if product_variant.available %}
{{ block.settings.quick_add_label }} - <span data-total-price>{{ product_variant.price | money }}</span>
{% else %}
Esaurito
{% endif %}
</button>
</form>
{% endif %}
</span>
</article>
{% if adv_rendered == false and should_render_adv %}
{% if forloop.index == 4 %}
{{ paradise_adv_card }}
{% assign adv_rendered = true %}
{% endif %}
{% endif %}
{% endfor %}
{% if adv_rendered == false and should_render_adv %}
{{ paradise_adv_card }}
{% endif %}
</div>
{% if block.settings.enable_load_more and grid_collection.products_count > block.settings.initial_visible_products %}
<div class="pcg-load-more-wrap">
<button class="pcg-load-more" type="button" data-load-more data-step="{{ block.settings.load_more_step }}">
{{ block.settings.load_more_label }}
</button>
</div>
{% endif %}
{% endpaginate %}
{% elsif request.design_mode %}
<div class="pcg-empty">Seleziona una collezione o apri questa sezione dentro una pagina collezione.</div>
{% endif %}
</div>
</section>
{% schema %}
{
"name": "Paradise Collection Grid",
"target": "section",
"stylesheet": "paradise-collection-grid.css",
"settings": [
{
"type": "checkbox",
"id": "use_current_collection",
"label": "Usa collezione corrente",
"default": false
},
{
"type": "collection",
"id": "collection",
"label": "Collezione manuale"
},
{
"type": "text",
"id": "kicker",
"label": "Sopratitolo",
"default": "Shop"
},
{
"type": "text",
"id": "heading",
"label": "Titolo"
},
{
"type": "select",
"id": "heading_alignment",
"label": "Allineamento titolo",
"default": "left",
"options": [
{ "value": "left", "label": "Sinistra" },
{ "value": "center", "label": "Centro" },
{ "value": "right", "label": "Destra" }
]
},
{
"type": "checkbox",
"id": "enable_load_more",
"label": "Mostra prodotti a pagine",
"default": true
},
{
"type": "range",
"id": "initial_visible_products",
"min": 4,
"max": 24,
"step": 1,
"label": "Prodotti visibili all'inizio",
"default": 12
},
{
"type": "range",
"id": "load_more_step",
"min": 2,
"max": 24,
"step": 1,
"label": "Prodotti da mostrare ogni click",
"default": 8
},
{
"type": "text",
"id": "load_more_label",
"label": "Testo bottone mostra altro",
"default": "Mostra altro"
},
{
"type": "select",
"id": "desktop_columns",
"label": "Colonne desktop",
"default": "3",
"options": [
{ "value": "3", "label": "3 prodotti per riga" },
{ "value": "4", "label": "4 prodotti per riga" }
]
},
{
"type": "select",
"id": "mobile_columns",
"label": "Colonne mobile",
"default": "1",
"options": [
{ "value": "1", "label": "1 colonna" },
{ "value": "2", "label": "2 colonne" }
]
},
{
"type": "checkbox",
"id": "show_price",
"label": "Mostra prezzo",
"default": true
},
{
"type": "checkbox",
"id": "show_vendor",
"label": "Mostra brand/vendor",
"default": false
},
{
"type": "checkbox",
"id": "show_quick_add",
"label": "Mostra quantita e aggiungi al carrello",
"default": true
},
{
"type": "text",
"id": "quick_add_label",
"label": "Testo bottone carrello",
"default": "Aggiungi al carrello"
},
{
"type": "checkbox",
"id": "show_hover_image",
"label": "Mostra seconda immagine al passaggio mouse",
